# syntax=docker/dockerfile:1.7

# 预构建前端镜像。
#
# 标准 Dockerfile 的 web-build 阶段要在容器内执行 bun + vite。当前生产服务器是
# QEMU 虚拟机（CPU 型号 qemu64，无 AVX2），bun 1.3.x 的二进制启动即触发
# "Illegal instruction (core dumped)"（exit 132），构建阶段无法执行。
#
# 因此提供本文件：前端产物在支持 AVX2 的机器上 `bun run build` 生成，
# 随代码一起放到 web/dist，镜像内只做文件复制，不执行任何 Node/bun 进程。
# 由 compose 的 WEB_DOCKERFILE 变量选择使用哪个 Dockerfile。
FROM nginx:1.27-alpine

COPY docker/web-dist /opt/canvas-release
COPY docker/canvas-web-entrypoint.sh /usr/local/bin/canvas-web-entrypoint
RUN chmod +x /usr/local/bin/canvas-web-entrypoint
COPY nginx.conf /etc/nginx/conf.d/default.conf

ENTRYPOINT ["/usr/local/bin/canvas-web-entrypoint"]

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
